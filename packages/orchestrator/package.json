{
  "name": "@trading-model/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent Node orchestrator for the trading-model pipeline",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "trading-model-agents": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "agents": "node dist/cli.js",
    "demo": "node dist/cli.js --task full-pipeline --symbol QQQ --mock",
    "test": "node --import tsx --test test/**/*.test.ts",
    "pretest": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
